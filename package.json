{
  "name": "shinypull",
  "version": "0.1.0",
  "description": "Social media statistics tracker for YouTube, TikTok, Twitch, and Kick",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/generateSitemap.js && vite build",
    "preview": "vite preview",
    "seed:top-creators": "node scripts/seedTopCreators.js",
    "seed:expanded": "node scripts/seedTopCreatorsExpanded.js",
    "collect:daily": "node scripts/collectDailyStats.js",
    "monitor:twitch": "node scripts/monitorTwitchStreams.js",
    "monitor:kick": "node scripts/monitorKickStreams.js",
    "seed:kick": "node scripts/seedTopKickCreators.js",
    "seed:bluesky": "node scripts/seedTopBlueskyCreators.js",
    "seed:music": "node scripts/seedTopMusicArtists.js",
    "seed:mastodon": "node scripts/seedTopMastodonCreators.js",
    "discover:mastodon": "node scripts/discoverMastodonCreators.js",
    "seed:rumble": "node scripts/seedTopRumbleCreators.js",
    "discover:rumble": "node scripts/discoverRumbleCreators.js",
    "aggregate:hours-watched": "node scripts/aggregateHoursWatched.js",
