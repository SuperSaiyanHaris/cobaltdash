    "@eslint/js": "^9.39.4",
    "@vitejs/plugin-react": "^6.0.2",
    "autoprefixer": "^10.4.20",
    "dotenv": "^17.2.3",
    "eslint": "^9.39.4",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.6.0",
    "pg": "^8.18.0",
    "postcss": "^8.5.13",
    "resend": "^6.12.4",
    "rss-parser": "^3.13.0",
