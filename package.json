  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@supabase/supabase-js": "^2.91.0",
    "@vercel/analytics": "^1.6.1",
    "@vercel/og": "^0.8.6",
    "cmdk": "^1.1.1",
    "framer-motion": "^12.40.0",
